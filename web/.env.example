# Sanity — same project as the Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Optional for a public dataset; required if the dataset is private
SANITY_API_READ_TOKEN=

# Model provider (see src/lib/agent/model.ts to swap providers)
ANTHROPIC_API_KEY=
SOMMELIER_MODEL=claude-sonnet-5-5

# Optional — Sanity Context in Knowledge Base mode.
# Copy the MCP URL from the Context app in the Sanity Dashboard and append:
#   ?mode=knowledge_base&knowledgeBases=kb_xxx
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
